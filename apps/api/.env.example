# PostgreSQL connection
DATABASE_URL="postgresql://HOST:PORT/poozari?schema=public"

# API
PORT=4000
# Public site origin. Used to build links inside notification emails.
WEB_BASE_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Public origin this API is reachable on. Uploaded images and pooja videos are
# stored as absolute URLs against it, because the web app is a different origin
# and cannot resolve a bare /uploads/... path.
PUBLIC_BASE_URL="http://localhost:4000"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# OTP delivery
# OTP_DEV_MODE=true returns the code in the API response instead of sending an
# SMS. It must be set explicitly, so a production deploy that forgets this
# variable sends real SMS rather than handing out login codes over the API.
# Leave it unset (or anything other than "true") in production.
OTP_DEV_MODE=true

# Mobile-number OTP login. Off until the DLT sender ID and OTP template are
# registered; while off, customers sign in by email only. Set to "true" here
# and NEXT_PUBLIC_PHONE_LOGIN_ENABLED="true" in the web app to turn it on.
PHONE_LOGIN_ENABLED=false

# Which SMS provider delivers the OTP. If unset, the first provider with
# credentials below is used; with none, codes are only written to the server log.
#   fast2sms | msg91 | twilio | log
SMS_PROVIDER=fast2sms

# Fast2SMS (https://docs.fast2sms.com) - transactional "otp" route, no DLT
# template registration required.
FAST2SMS_API_KEY=""

# MSG91 (https://docs.msg91.com) - the template must be a DLT-approved OTP
# template whose variable is named OTP.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# Twilio - for numbers outside India.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Razorpay (test keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"
# Set this to the same value in Razorpay -> Settings -> Webhooks, pointing at
# <PUBLIC_BASE_URL>/api/payments/webhook for payment.captured, payment.failed
# and order.paid. Without it a payment whose browser tab closed mid-redirect is
# never settled: Razorpay has the money and the booking stays unpaid.
# It is NOT the API key secret — a different secret and a different payload.
RAZORPAY_WEBHOOK_SECRET=""

# Seed super admin
SEED_ADMIN_EMAIL="admin@poozari.com"
SEED_ADMIN_PASSWORD="admin12345"

# Seed test customer. Customers normally sign in with an OTP; this one gets a
# password so manual testing does not need a code every time. Reseeding resets
# the password. Remove this account before going live.
SEED_CUSTOMER_PHONE="9000000009"
SEED_CUSTOMER_PASSWORD="customer12345"
# Set to false in production: an account with a documented password does not
# belong on a live site.
SEED_TEST_CUSTOMER=true

# Pandit login password. Like the admin one, the default is published in this
# repository, so set it for any real deployment.
SEED_PANDIT_PASSWORD="pandit12345"

# Email (SMTP). Outgoing only: the app sends notifications, it never reads a
# mailbox, so no IMAP settings are needed here. With these unset, emails are
# written to the server log instead of being sent.
#
# Hostinger: host smtp.hostinger.com, port 465 (implicit TLS) or 587 (STARTTLS),
# user = the full mailbox address.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
# Optional. Defaults to "poozari.com <SMTP_USER>".
SMTP_FROM=""
# Where enquiries, applications and booking alerts are delivered.
# Defaults to SMTP_USER.
NOTIFY_EMAIL=""
