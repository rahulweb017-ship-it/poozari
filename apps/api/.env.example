# PostgreSQL connection
DATABASE_URL="postgresql://HOST:PORT/poozari?schema=public"

# API
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# OTP (dev: codes are returned in the API response instead of being sent by SMS)
# Set OTP_DEV_MODE=false to send real SMS via Fast2SMS.
OTP_DEV_MODE=true

# Fast2SMS (https://docs.fast2sms.com) - used for OTP SMS when OTP_DEV_MODE=false
FAST2SMS_API_KEY=""

# Razorpay (test keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"

# Seed super admin
SEED_ADMIN_EMAIL="admin@poozari.com"
SEED_ADMIN_PASSWORD="admin12345"
