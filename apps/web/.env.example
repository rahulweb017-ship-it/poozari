# Public API base URL (used by the browser). Include the /api prefix.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Server-side API base URL (used by server components / SSR).
API_URL="http://localhost:4000/api"

# Business WhatsApp number for the "Book on WhatsApp" buttons.
# Baked into the client bundle, so a change needs a rebuild.
NEXT_PUBLIC_WHATSAPP_NUMBER="+919041399200"
